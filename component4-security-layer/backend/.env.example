# Server
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10

# Component 4 operational database. Academic records remain owned by Component 1.
MONGODB_URI=mongodb://127.0.0.1:27017/ZKP_Login
# Component 1 is the sole academic-data authority. Component 4 refuses to
# start without this API and contains no academic-record fallback dataset.
ACADEMIC_DATA_BASE_URL=http://localhost:5002/proof
# Mandatory claim-bound Groth16 verification. Artifacts are generated by
# `node scripts/setup.js` and kept under build/ (never commit private zkeys in
# a public deployment; publish only the verification key).
REQUIRE_GRADE_ZKP=true
