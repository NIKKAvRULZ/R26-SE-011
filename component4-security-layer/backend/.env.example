# Server
PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10

# Component 4 operational database. Academic records remain owned by Component 1.
MONGODB_URI=mongodb://127.0.0.1:27017/ZKP_Login
# Component 1 base proof endpoint; Component 4 calls GET /record/:candidateId/:moduleCode.
ACADEMIC_DATA_BASE_URL=http://localhost:4000/proof
REQUIRE_GRADE_ZKP=false

# Existing grade-verification blockchain / proof settings
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
FINALIZED_DATASET_CID=bafycomponent4demofinalizeddataset0001
BLOCKCHAIN_MERKLE_ROOT=

# Optional IPFS gateway configuration for future integrations
IPFS_GATEWAY_URL=https://gateway.ipfs.io/ipfs
